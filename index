function fazerLogin(){
  const now = Date.now();
  if(APP.loginAttempts >= MAX_ATT && now-APP.lastAttempt < LOCK_MS){
    const r=Math.ceil((LOCK_MS-(now-APP.lastAttempt))/60000);
    errLogin(`Bloqueado. Tente em ${r} min.`);return;
  }
  const email=san(el('e-email').value), senha=el('e-senha').value;
  el('login-err').style.display='none';
  if(!email||!senha){errLogin('Preencha e-mail e senha.');return;}
  const btn=el('btn-login'); btn.disabled=true;
  el('login-txt').textContent='Autenticando...';
  APP.lastAttempt=now;
  google.script.run
    .withSuccessHandler(res=>{
      btn.disabled=false; el('login-txt').textContent='Entrar no Sistema';
      if(res.ok){APP.loginAttempts=0;APP.user=res.user;iniciarApp(res.user);}
      else{APP.loginAttempts++;errLogin(res.msg||'Credenciais inválidas.');}
    })
    .withFailureHandler(()=>{btn.disabled=false;el('login-txt').textContent='Entrar no Sistema';errLogin('Erro de conexão.');})
    .login(email,senha);
}
function errLogin(m){const e=el('login-err');e.textContent=san(m);e.style.display='block';}
