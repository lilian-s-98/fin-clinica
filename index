//  USUÁRIOS
// ================================================================
function abrirFormUsr(){el('form-usr').style.display='block';el('form-usr').scrollIntoView({behavior:'smooth'});}
function carregarUsrs(){
  const w=el('usr-lista');if(!w)return;
  w.innerHTML='<div class="lw"><div class="spin"></div></div>';
  google.script.run.withSuccessHandler(users=>{
    if(!users||!users.length){w.innerHTML='<div class="alert alert-info">Nenhum usuário.</div>';return;}
    w.innerHTML=`<div class="prof-grid">${users.map(u=>`<div class="prof-card"><div class="prof-av" style="background:${PERFIS_COLOR[u.perfil]||'var(--text-3)'}">${u.nome[0].toUpperCase()}</div><div class="prof-info"><div class="prof-nm">${san(u.nome)}</div><div class="prof-em">${san(u.email)}</div><span class="bdg bdg-gray" style="margin-top:4px">${PERFIS_LBL[u.perfil]||u.perfil}</span></div>${u.id!==APP.user?.id?`<button class="btn btn-d btn-xs" onclick="excluirUsr('${u.id}')"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>`:'<span style="font-size:.68rem;color:var(--text-3)">Você</span>'}</div>`).join('')}</div>`;
  }).withFailureHandler(e=>{w.innerHTML=`<div class="alert alert-err">${e.message}</div>`;}).getUsuarios(APP.user);
}
function salvarUsr(){
  const nome=san(el('usr-nome').value),email=san(el('usr-email').value),senha=el('usr-senha').value,perfil=el('usr-perfil').value;
  if(!nome||!email||!senha){toast('Preencha todos os campos.','err');return;}
  if(senha.length<8){toast('Senha deve ter no mínimo 8 caracteres.','err');return;}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){toast('E-mail inválido.','err');return;}
  const btn=event.target;btn.disabled=true;
  google.script.run.withSuccessHandler(res=>{btn.disabled=false;if(res.ok){toast('Usuário criado!','ok');el('form-usr').style.display='none';carregarUsrs();}else toast('Erro: '+san(res.msg),'err');}).withFailureHandler(e=>{btn.disabled=false;toast(e.message,'err');}).criarUsuario({nome,email,senha,perfil},APP.user);
}
function excluirUsr(id){
  if(!confirm('Confirma a remoção deste usuário? Esta ação será registrada no log de auditoria.'))return;
  google.script.run.withSuccessHandler(res=>{if(res.ok){toast('Usuário removido.','ok');carregarUsrs();}else toast('Erro: '+san(res.msg),'err');}).excluirUsuario(id,APP.user);
}

