function abrirModal(titulo,corpo,rodape,size){
  el('modal-titulo').textContent=san(titulo);
  el('modal-bd').innerHTML=corpo;
  el('modal-ft').innerHTML=rodape||'';
  el('modal-box').className='modal '+(size||'');
  el('modal-ov').style.display='flex';
}
function fecharModal(){el('modal-ov').style.display='none';}
document.addEventListener('keydown',e=>{if(e.key==='Escape')fecharModal();});
