// ================================================================
function abrirFormProf(){el('form-prof').style.display='block';el('form-prof').scrollIntoView({behavior:'smooth'});}
function carregarProfs(){const w=el('prof-lista');if(!w)return;if(APP.listas){renderProfs(APP.listas.profissionais);return;}google.script.run.withSuccessHandler(l=>{APP.listas=l;renderProfs(l.profissionais);}).getListas();}
function renderProfs(profs){
  el('prof-lista').innerHTML=`<div class="panel"><div class="tw"><table class="tbl"><thead><tr><th>ID</th><th>Nome</th><th>Especialidade</th><th>Vínculo</th><th>Cor</th><th>Status</th></tr></thead><tbody>${profs.map((p,i)=>`<tr><td><span class="bdg bdg-blue">${p.id}</span></td><td><strong>${san(p.nome)}</strong></td><td>${san(p.especialidade)}</td><td><span class="bdg bdg-teal">${p.tipo_vinculo||'PJ'}</span></td><td><div style="width:18px;height:18px;border-radius:50%;background:${p.cor||PROF_CORES[i%PROF_CORES.length]};display:inline-block"></div></td><td><span class="bdg bdg-green">Ativo</span></td></tr>`).join('')}</tbody></table></div></div>`;
}
function salvarProf(){
  const nome=san(el('prof-nome').value),esp=san(el('prof-esp').value);if(!nome||!esp){toast('Informe nome e especialidade.','err');return;}
  const btn=event.target;btn.disabled=true;
  google.script.run.withSuccessHandler(res=>{btn.disabled=false;if(res.ok){toast('Profissional cadastrado!','ok');el('form-prof').style.display='none';google.script.run.withSuccessHandler(l=>{APP.listas=l;carregarProfs();}).getListas();}else toast('Erro: '+san(res.msg),'err');}).withFailureHandler(e=>{btn.disabled=false;toast(e.message,'err');}).salvarProfissional({nome,especialidade:esp,registro:el('prof-reg').value,tipo_vinculo:el('prof-vinc').value,percentual:el('prof-pct').value,cor:el('prof-cor').value},APP.user);
}

