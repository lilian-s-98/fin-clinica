    const rows=MESES.map(m=>{const p=pb[m]||0,c=cb[m]||0,d=db[m]||0,t=p+c,res=t-d;if(t>0||d>0)ac+=res;return{m,p,c,t,d,res,ac,has:t>0||d>0};});
    const tres=rows.reduce((s,r)=>s+r.res,0);
    w.innerHTML=`<div class="panel"><div class="ph"><span class="pt">Fluxo de Caixa — 2026</span></div><div class="alert alert-blue" style="margin:14px"><svg class="alrt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg><div>Convênios pagam com 30–90 dias de atraso. Atualize o status das guias para refletir o caixa real.</div></div><div class="tw"><table class="tbl"><thead><tr><th>Mês</th><th>+ Particular</th><th>+ Convênios</th><th>= Receitas</th><th>– Despesas</th><th>Resultado</th><th>Acumulado</th></tr></thead><tbody>${rows.map(r=>`<tr><td><strong>${r.m}</strong></td><td style="color:var(--amber)">${r.p?fmt(r.p):'—'}</td><td style="color:var(--teal)">${r.c?fmt(r.c):'—'}</td><td style="font-weight:600">${r.t?fmt(r.t):'—'}</td><td style="color:var(--red)">${r.d?fmt(r.d):'—'}</td><td style="font-weight:700;color:${r.has?(r.res>=0?'var(--green)':'var(--red)'):'var(--text-3)'}">${r.has?fmt(r.res):'—'}</td><td style="font-weight:600">${r.ac?fmt(r.ac):'—'}</td></tr>`).join('')}</tbody><tfoot><tr><td><strong>TOTAL</strong></td><td><strong>${fmt(rows.reduce((s,r)=>s+r.p,0))}</strong></td><td><strong>${fmt(rows.reduce((s,r)=>s+r.c,0))}</strong></td><td><strong>${fmt(rows.reduce((s,r)=>s+r.t,0))}</strong></td><td><strong>${fmt(rows.reduce((s,r)=>s+r.d,0))}</strong></td><td style="color:${tres>=0?'var(--green)':'var(--red)'}"><strong>${fmt(tres)}</strong></td><td></td></tr></tfoot></table></div></div>`;
  });
}

// ================================================================
//  PACIENTES
// ================================================================
let _allPacs=[];
function abrirFormPac(){el('form-pac').style.display='block';if(APP.listas){const s=el('pac-conv');if(s)s.innerHTML=APP.listas.convenios.map(c=>`<option value="${c.nome}">${c.nome}</option>`).join('');}el('form-pac').scrollIntoView({behavior:'smooth'});}
function mskCPF(i){let v=i.value.replace(/\D/g,'');v=v.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');i.value=v.slice(0,14);}
function mskTel(i){let v=i.value.replace(/\D/g,'').slice(0,11);if(v.length>6)v='('+v.slice(0,2)+') '+v.slice(2,7)+'-'+v.slice(7);else if(v.length>2)v='('+v.slice(0,2)+') '+v.slice(2);else if(v.length)v='('+v;i.value=v;}
function mskCEP(i){let v=i.value.replace(/\D/g,'');if(v.length>5)v=v.slice(0,5)+'-'+v.slice(5,8);i.value=v;}
function buscaCEP(){const cep=el('pac-cep').value.replace(/\D/g,'');if(cep.length!==8)return;fetch(`https://viacep.com.br/ws/${cep}/json/`).then(r=>r.json()).then(d=>{if(!d.erro){el('pac-end').value=d.logradouro||'';el('pac-bairro').value=d.bairro||'';el('pac-cidade').value=d.localidade||'';}}).catch(()=>{});}
function carregarPacs(){if(APP.listas){_allPacs=APP.listas.pacientes||[];renderPacs(_allPacs);return;}google.script.run.withSuccessHandler(l=>{APP.listas=l;_allPacs=l.pacientes||[];renderPacs(_allPacs);}).getListas();}
function renderPacs(pacs){
  const l=el('pac-lista');
  if(!pacs.length){l.innerHTML='<div class="alert alert-info" style="margin:14px">Nenhum paciente cadastrado.</div>';return;}
  l.innerHTML=`<div class="tw"><table class="tbl"><thead><tr><th>ID</th><th>Nome</th><th>CPF</th><th>Telefone</th><th>E-mail</th><th>Convênio</th></tr></thead><tbody>${pacs.map(p=>`<tr><td><span class="bdg bdg-blue">${p.id}</span></td><td><strong>${san(p.nome)}</strong></td><td>${p.cpf||'—'}</td><td>${p.telefone||'—'}</td><td>${p.email||'—'}</td><td><span class="bdg bdg-teal">${p.convenio||'PARTICULAR'}</span></td></tr>`).join('')}</tbody></table></div>`;
}
function filtrarPacs(q){renderPacs(_allPacs.filter(p=>p.nome.toLowerCase().includes(q.toLowerCase())||(p.cpf&&p.cpf.includes(q))));}
function salvarPac(){
  const nome=san(el('pac-nome').value);if(!nome){toast('Informe o nome do paciente.','err');return;}
  const dados={nome,cpf:el('pac-cpf').value,nascimento:el('pac-nasc').value,telefone:el('pac-tel').value,email:el('pac-email').value,convenio_principal:el('pac-conv').value,cep:el('pac-cep').value,logradouro:san(el('pac-end').value),numero:el('pac-num').value,complemento:san(el('pac-comp').value),bairro:san(el('pac-bairro').value),cidade:san(el('pac-cidade').value),observacoes:san(el('pac-obs').value)};
  const btn=event.target;btn.disabled=true;
  google.script.run.withSuccessHandler(res=>{btn.disabled=false;if(res.ok){toast('Paciente cadastrado!','ok');el('form-pac').style.display='none';google.script.run.withSuccessHandler(l=>{APP.listas=l;carregarPacs();}).getListas();}else toast('Erro: '+san(res.msg),'err');}).withFailureHandler(e=>{btn.disabled=false;toast(e.message,'err');}).salvarPaciente(dados,APP.user);
}

