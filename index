    return`<div class="bc" title="${MESES[i]}: Part. ${fmt(v.particular)} | Conv. ${fmt(v.convenio)} | Desp. ${fmt(v.despesa)}">
      <div class="bs"><div class="bs-seg" style="height:${hd}%;background:var(--red);opacity:.5"></div><div class="bs-seg" style="height:${hp}%;background:var(--gold)"></div><div class="bs-seg" style="height:${hc}%;background:var(--teal)"></div></div>
      <div class="bc-lbl">${MESES_ABR[i]}</div></div>`;
  }).join('')}</div><div class="chart-leg"><div class="leg-i"><div class="leg-d" style="background:var(--teal)"></div>Convênios</div><div class="leg-i"><div class="leg-d" style="background:var(--gold)"></div>Particular</div><div class="leg-i"><div class="leg-d" style="background:var(--red)"></div>Despesas</div></div>`;
}
function renderDonut(pc){
  const svg=el('donut-conv'),leg=el('donut-leg');if(!svg)return;
  const ents=Object.entries(pc).sort((a,b)=>b[1]-a[1]);
  const tot=ents.reduce((s,[,v])=>s+v,0);
  if(!tot){svg.innerHTML='<text x="65" y="70" text-anchor="middle" font-size="10" fill="#94a3b8">Sem dados</text>';return;}
  const r=47,cx=65,cy=65,sw=18,c=2*Math.PI*r;let off=0;
  let s=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#e2e8f0" stroke-width="${sw}"/>`;
  ents.forEach(([,v],i)=>{
    const d=c*(v/tot),cor=CORES[i%CORES.length];
    s+=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${cor}" stroke-width="${sw}" stroke-dasharray="${d} ${c-d}" stroke-dashoffset="${-off}" transform="rotate(-90 ${cx} ${cy})"/>`;
    off+=d;
  });
  s+=`<text x="${cx}" y="${cy-4}" text-anchor="middle" font-size="10" font-weight="700" fill="#0d1b36">${(tot/1000).toFixed(0)}k</text><text x="${cx}" y="${cy+9}" text-anchor="middle" font-size="8" fill="#94a3b8">Total</text>`;
  svg.innerHTML=s;
  leg.innerHTML=ents.slice(0,6).map(([n,v],i)=>`<div class="dl-item"><div class="dl-dot" style="background:${CORES[i%CORES.length]}"></div><span style="flex:1">${n}</span><strong>${(v/tot*100).toFixed(1)}%</strong></div>`).join('');
}
