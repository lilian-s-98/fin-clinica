function buildChecklistPage(defs,hist,cont){
  if(!defs.length){cont.innerHTML='<div class="alert alert-info"><svg class="alrt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg><div>Nenhum checklist configurado para seu perfil. Solicite ao administrador.</div></div>';return;}
  const histMap={};
  hist.forEach(h=>{histMap[h.checklist_id]={concluido:h.concluido==='SIM',obs:h.observacao||''};});
  const cats=[...new Set(defs.map(d=>d.categoria))];
  const d=new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});
  const total=defs.length;
  const concl=defs.filter(x=>histMap[x.id]&&histMap[x.id].concluido).length;
  const pct=total>0?Math.round(concl/total*100):0;
  let html=`<div class="page-hd"><div><h2>Meu Checklist Diário</h2><div class="page-hd-sub">${d.charAt(0).toUpperCase()+d.slice(1)} · Perfil: ${PERFIS_LBL[APP.user.perfil]||APP.user.perfil}</div></div></div>
  <div class="panel">
    <div class="ph"><span class="pt"><svg class="pt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Tarefas de hoje</span><span style="font-size:.73rem;color:var(--text-3)">${concl}/${total} concluídas</span></span></div>
    <div class="pb">
      <div class="chk-prog-wrap">
        <div class="chk-prog-hd"><span class="chk-prog-lbl">Progresso de hoje</span><span class="chk-prog-num" id="chk-pct">${pct}%</span></div>
        <div class="chk-bar"><div class="chk-bar-fill" id="chk-fill" style="width:${pct}%"></div></div>
      </div>
      <div class="chk-wrap" id="chk-wrap">`;
  cats.forEach(cat=>{
    const catDefs=defs.filter(x=>x.categoria===cat);
    html+=`<div class="chk-cat-label">${san(cat)}</div>`;
    catDefs.forEach(def=>{
      const st=histMap[def.id]||{};
      const done=st.concluido||false;
      const obs=st.obs||'';
      html+=`<div class="chk-item ${done?'done':''}" id="ci-${def.id}" onclick="toggleChkItem('${def.id}')">
        <div class="chk-box">${done?'<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>':''}</div>
        <div class="chk-body">
          <div class="chk-lbl">${san(def.titulo)}</div>
          ${def.descricao?`<div class="chk-desc">${san(def.descricao)}</div>`:''}
          <div class="chk-meta">
            <span class="bdg ${def.obrigatorio==='SIM'?'bdg-blue':'bdg-gray'}">${def.obrigatorio==='SIM'?'Obrigatório':'Opcional'}</span>
            ${done?'<span class="bdg bdg-green">Concluído</span>':''}
          </div>
          <div class="chk-obs-row" onclick="event.stopPropagation()">
            <input class="chk-obs" id="obs-${def.id}" type="text" placeholder="Observação (opcional)" value="${san(obs)}" oninput="salvarObsLocal('${def.id}',this.value)">
          </div>
        </div>
      </div>`;
    });
  });
  html+=`</div>
      <div class="chk-submit-area">
        <div class="alert alert-blue" style="margin-bottom:10px"><svg class="alrt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><div>Ao enviar o checklist, ele fica registrado com data e hora. A gestora pode ver sua conformidade. Envie mesmo que não tenha concluído tudo.</div></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <button class="btn btn-g btn-sm" onclick="renderChecklistPage()">Recarregar</button>
          <button class="btn btn-p" onclick="enviarChecklist()"><svg class="btn-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Enviar Checklist do Dia</button>
        </div>
      </div>
    </div>
  </div>`;
  hist.length&&(html+=`<div class="panel"><div class="ph"><span class="pt">Histórico Recente</span></div><div class="pb" style="font-size:.8rem;color:var(--text-2)">Último envio registrado às ${hist[0]&&hist[0].hora_conclusao?hist[0].hora_conclusao:'—'} · ${hist.filter(h=>h.concluido==='SIM').length} itens concluídos de ${hist.length}</div></div>`);
  cont.innerHTML=html;
}

const _chkLocal={};
function salvarObsLocal(id,v){_chkLocal[id]=_chkLocal[id]||{};_chkLocal[id].obs=v;}
function toggleChkItem(id){
  const item=el('ci-'+id);if(!item)return;
  _chkLocal[id]=_chkLocal[id]||{};
  const done=!(_chkLocal[id].concluido||false);
  _chkLocal[id].concluido=done;
  item.classList.toggle('done',done);
  const box=item.querySelector('.chk-box');
  box.innerHTML=done?'<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>':'';
  const meta=item.querySelector('.chk-meta');
  const bdgDone=meta.querySelector('.bdg-green');
  if(done&&!bdgDone) meta.insertAdjacentHTML('beforeend','<span class="bdg bdg-green">Concluído</span>');
  else if(!done&&bdgDone) bdgDone.remove();
  const total=APP.checkDefs.length;
  const concl=Object.values(_chkLocal).filter(x=>x.concluido).length;
  const pct=total>0?Math.round(concl/total*100):0;
  const f=el('chk-fill'),p=el('chk-pct');
  if(f) f.style.width=pct+'%';
  if(p) p.textContent=pct+'%';
}

function enviarChecklist(){
  if(!APP.checkDefs.length){toast('Nenhuma definição de checklist.','err');return;}
  const items=APP.checkDefs.map(def=>{
    const st=_chkLocal[def.id]||{};
    return{checklist_id:def.id,titulo:def.titulo,concluido:st.concluido||false,obrigatorio:def.obrigatorio,observacao:st.obs||''};
  });
  const btn=event.target;btn.disabled=true;btn.textContent='Enviando...';
  google.script.run
    .withSuccessHandler(res=>{
      btn.disabled=false;btn.innerHTML='<svg class="btn-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Enviar Checklist do Dia';
      if(res.ok){
        toast(`Checklist enviado! Conformidade: ${res.pct}% (${res.concluidos} obrigatórios concluídos)`,'ok');
        renderChecklistPage();
      } else toast('Erro ao enviar: '+san(res.msg),'err');
    })
    .withFailureHandler(e=>{btn.disabled=false;btn.textContent='Enviar Checklist do Dia';toast(e.message,'err');})
    .salvarChecklistDia(items,APP.user);
}

