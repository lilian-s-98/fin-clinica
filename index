function perguntarIA(q){const i=el('ai-input');if(i)i.value=q;enviarIA();}
function enviarIA(){
  const input=el('ai-input');
  const q=input?input.value.trim():'';
  if(!q)return;
  const chat=el('ai-chat');
  if(!chat)return;
  input.value='';
  chat.innerHTML+=`<div class="ai-msg user" style="margin-bottom:7px;padding:8px 11px;border-radius:8px;font-size:.79rem;line-height:1.5;background:rgba(255,255,255,.15);text-align:right">${san(q)}</div>`;
  chat.innerHTML+=`<div id="ai-typing" style="display:flex;gap:4px;align-items:center;padding:8px 11px"><div style="width:6px;height:6px;background:rgba(255,255,255,.6);border-radius:50%;animation:aiDot 1.2s infinite"></div><div style="width:6px;height:6px;background:rgba(255,255,255,.6);border-radius:50%;animation:aiDot 1.2s infinite .2s"></div><div style="width:6px;height:6px;background:rgba(255,255,255,.6);border-radius:50%;animation:aiDot 1.2s infinite .4s"></div></div>`;
  chat.scrollTop=chat.scrollHeight;
  APP.aiHistory.push({role:'user',content:q});
  const ctx=APP.dashCtx;
  const ctxStr=ctx?`Dados do Instituto da Dor: Receita particular: ${fmt(ctx.kpis.recParticular)}, Convênios: ${fmt(ctx.kpis.recConvenio)}, Despesas: ${fmt(ctx.kpis.totalDespesas)}, Resultado: ${fmt(ctx.kpis.resultado)}, Guias pendentes: ${ctx.kpis.qtdGuiasPendentes}, Ticket médio: ${fmt(ctx.kpis.ticketMedio)}. Top convênios: ${Object.entries(ctx.porConvenio||{}).slice(0,4).map(([n,v])=>`${n}: ${fmt(v)}`).join(', ')}`:'';
  google.script.run
    .withSuccessHandler(resp=>{
      const t=el('ai-typing');if(t)t.remove();
      chat.innerHTML+=`<div class="ai-msg bot" style="margin-bottom:7px;padding:8px 11px;border-radius:8px;font-size:.79rem;line-height:1.5;background:rgba(0,0,0,.2)">${san(resp||'—')}</div>`;
