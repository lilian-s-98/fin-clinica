<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Instituto da Dor — Gestão v5.0</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
<style>
:root {
  --blue:#0049AF; --blue-dk:#00276B; --blue-lt:#1a5fc4;
  --blue-xl:#e8f0fb; --blue-2xl:#f0f5ff;
  --gold:#FAAF34; --gold-dk:#e09a1a; --gold-lt:#ffc65a; --gold-pale:#fff8e8;
  --ink:#04123B; --emerald:#0f9d76; --emerald-lt:#dafaf0;
  --white:#ffffff; --bg:#eef3fb; --surface:#ffffff;
  --surface-2:#f7faff; --surface-3:#eef4ff;
  --text:#0d1b36; --text-2:#4a5568; --text-3:#94a3b8;
  --green:#16a34a; --green-lt:#dcfce7;
  --red:#dc2626; --red-lt:#fee2e2;
  --amber:#d97706; --amber-lt:#fef3c7;
  --teal:#0891b2; --teal-lt:#e0f2fe;
  --purple:#7c3aed; --purple-lt:#ede9fe;
  --border:#dbe6f5; --border-2:#c2d3eb;
  --sh-xs:0 1px 3px rgba(4,18,59,.06);
  --sh-sm:0 2px 8px rgba(4,18,59,.09);
  --sh-md:0 6px 20px rgba(4,18,59,.12);
  --sh-lg:0 10px 36px rgba(4,18,59,.16);
  --sh-xl:0 22px 64px rgba(0,0,0,.2);
  --r-sm:7px; --r-md:12px; --r-lg:18px; --r-xl:26px; --r-full:9999px;
  --sw:260px; --th:60px;
  --tx:.15s cubic-bezier(.4,0,.2,1);
  --tx-md:.25s cubic-bezier(.4,0,.2,1);
  --tx-lg:.35s cubic-bezier(.4,0,.2,1);
  --fd:'Outfit',system-ui,sans-serif;
  --fb:'DM Sans',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:14.5px;-webkit-font-smoothing:antialiased}
body{font-family:var(--fb);background:var(--bg);color:var(--text);overflow-x:hidden}
input,select,textarea,button{font-family:inherit;font-size:inherit}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:rgba(0,73,175,.2);border-radius:99px}
::selection{background:rgba(0,73,175,.14)}

/* ── LOGOMARK (SVG inline, sem base64 gigante) ── */
.logomark{display:block}
.logomark .lm-blue{fill:none;stroke:var(--blue);stroke-width:13;stroke-linecap:round}
.logomark .lm-gold{fill:var(--gold)}
.logomark .lm-gold2{fill:none;stroke:var(--gold);stroke-width:7;stroke-linecap:round;opacity:.9}

/* LOGIN */
.login-shell{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(circle at 15% 15%,#0a3da3 0%,#001f5e 38%,#001138 100%);
  padding:20px;position:relative;overflow:hidden}
.login-shell::before{content:'';position:absolute;inset:0;background-image:
  repeating-linear-gradient(135deg,rgba(255,255,255,.025) 0 2px,transparent 2px 26px);
  pointer-events:none}
.lo1,.lo2,.lo3{position:absolute;border-radius:50%;pointer-events:none;filter:blur(2px)}
.lo1{width:560px;height:560px;background:radial-gradient(circle,rgba(250,175,52,.16),transparent 70%);top:-220px;right:-180px}
.lo2{width:380px;height:380px;background:radial-gradient(circle,rgba(15,157,118,.14),transparent 70%);bottom:-160px;left:-120px}
.lo3{width:240px;height:240px;background:radial-gradient(circle,rgba(255,255,255,.08),transparent 70%);bottom:30%;right:8%}
.login-card{background:rgba(255,255,255,.98);backdrop-filter:blur(20px);
  border-radius:var(--r-xl);padding:42px 38px 34px;width:100%;max-width:408px;
  box-shadow:var(--sh-xl);position:relative;z-index:1;animation:slideUp .45s ease;
  border-top:4px solid var(--gold)}
.lc-logo{text-align:center;margin-bottom:26px}
.lc-logo svg{width:60px;height:60px;margin:0 auto 12px;display:block}
.lc-logo h1{font-family:var(--fd);font-size:1.32rem;font-weight:800;color:var(--blue);letter-spacing:-.5px}
.lc-logo p{font-size:.73rem;color:var(--text-3);margin-top:3px;letter-spacing:.3px}
.lf{margin-bottom:14px}
.lf label{display:block;font-size:.68rem;font-weight:700;color:var(--text-2);margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
.lf-in{position:relative}
.lf-ic{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-3);pointer-events:none}
.lf input{width:100%;padding:11px 13px 11px 38px;border:1.5px solid var(--border);border-radius:var(--r-md);font-size:.88rem;color:var(--text);background:#fff;transition:border-color var(--tx),box-shadow var(--tx)}
.lf input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,73,175,.1)}
.login-err{background:var(--red-lt);color:var(--red);padding:9px 13px;border-radius:var(--r-sm);font-size:.78rem;margin-bottom:12px;display:none;border-left:3px solid var(--red)}
.btn-login{width:100%;padding:13px;background:linear-gradient(135deg,var(--blue),var(--blue-lt));color:#fff;border:none;border-radius:var(--r-md);font-family:var(--fd);font-weight:700;font-size:.95rem;cursor:pointer;transition:all var(--tx);margin-top:4px;letter-spacing:.2px}
.btn-login:hover{transform:translateY(-1px);box-shadow:0 4px 18px rgba(0,73,175,.4)}
.btn-login:active{transform:scale(.98)}
.btn-login:disabled{opacity:.7;cursor:wait}
.login-badge{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:18px;padding:10px;background:var(--blue-2xl);border-radius:var(--r-md);font-size:.68rem;color:var(--blue);font-weight:600}
.login-demo{margin-top:14px;text-align:center;font-size:.66rem;color:var(--text-3)}

/* APP SHELL */
.app-shell{display:grid;grid-template-columns:var(--sw) 1fr;grid-template-rows:var(--th) 1fr;grid-template-areas:"sb tb""sb mc";min-height:100vh;display:none}

/* SIDEBAR */
.sidebar{grid-area:sb;background:linear-gradient(195deg,#001a4d 0%,#002a72 55%,#003a8c 100%);
  height:100vh;position:sticky;top:0;display:flex;flex-direction:column;
  overflow-y:auto;overflow-x:hidden;z-index:100;transition:transform var(--tx-lg);
  border-right:1px solid rgba(255,255,255,.06)}
.sb-brand{padding:18px 18px 15px;border-bottom:1px solid rgba(255,255,255,.08)}
.sb-brand-row{display:flex;align-items:center;gap:10px}
.sb-brand-logo{width:34px;height:34px;flex-shrink:0;background:rgba(255,255,255,.94);border-radius:10px;display:flex;align-items:center;justify-content:center;padding:5px}
.sb-brand-logo svg{width:100%;height:100%}
.sb-brand-name{font-family:var(--fd);font-size:.86rem;font-weight:800;color:#fff;line-height:1.2;letter-spacing:-.3px}
.sb-brand-sub{font-size:.62rem;color:rgba(255,255,255,.45);margin-top:1px}
.sb-user{padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.08)}
.sb-greet{font-size:.62rem;color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.6px}
.sb-name{font-family:var(--fd);font-size:.88rem;color:#fff;font-weight:700;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-badge{display:inline-flex;align-items:center;gap:4px;margin-top:6px;font-size:.6rem;padding:3px 9px;border-radius:var(--r-full);background:rgba(250,175,52,.18);color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.nav-scroll{flex:1;overflow-y:auto;padding:10px 10px}
.nav-sec{padding:5px 0}
.nav-lbl{font-size:.58rem;font-weight:700;color:rgba(255,255,255,.32);text-transform:uppercase;letter-spacing:.8px;padding:7px 8px 4px}
.nav-item{display:flex;align-items:center;gap:9px;padding:9px 12px;color:rgba(255,255,255,.62);font-size:.81rem;font-weight:500;cursor:pointer;border-radius:var(--r-md);transition:all var(--tx);margin-bottom:2px}
.nav-item:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.92)}
.nav-item.active{background:linear-gradient(90deg,rgba(250,175,52,.22),rgba(250,175,52,.05));color:#fff;font-weight:700;box-shadow:inset 3px 0 0 var(--gold)}
.ni-icon{width:15px;height:15px;flex-shrink:0;opacity:.7;transition:opacity var(--tx)}
.nav-item.active .ni-icon,.nav-item:hover .ni-icon{opacity:1}
.sb-footer{padding:12px 18px;border-top:1px solid rgba(255,255,255,.08)}
.btn-logout{width:100%;padding:9px 12px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-md);font-size:.77rem;cursor:pointer;transition:all var(--tx);display:flex;align-items:center;gap:7px;justify-content:center}
.btn-logout:hover{background:rgba(220,38,38,.18);color:#fff;border-color:rgba(220,38,38,.3)}

/* TOPBAR */
.topbar{grid-area:tb;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 22px;height:var(--th);position:sticky;top:0;z-index:50;box-shadow:0 1px 0 rgba(0,0,0,.05)}
.tb-left{display:flex;align-items:center;gap:12px}
.tb-right{display:flex;align-items:center;gap:8px}
.sb-toggle{display:none;background:none;border:none;cursor:pointer;color:var(--text-2);padding:6px;border-radius:var(--r-sm)}
.page-title{font-family:var(--fd);font-size:1rem;font-weight:700;color:var(--text);letter-spacing:-.3px}
.tb-filter{display:flex;align-items:center;gap:7px}
.tb-filter label{font-size:.72rem;font-weight:600;color:var(--text-3)}
.tb-filter select{padding:6px 10px;border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:.78rem;background:#fff;color:var(--text);cursor:pointer}
.notif-btn{position:relative;background:none;border:1.5px solid var(--border);border-radius:var(--r-md);padding:7px 12px;cursor:pointer;color:var(--text-2);transition:all var(--tx);display:flex;align-items:center;gap:5px;font-size:.8rem}
.notif-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-xl)}
.notif-dot{position:absolute;top:-4px;right:-4px;width:16px;height:16px;background:var(--red);border-radius:50%;display:none;align-items:center;justify-content:center;font-size:.58rem;color:#fff;font-weight:700;border:2px solid #fff}

/* NOTIF */
.notif-panel{position:fixed;top:calc(var(--th) + 6px);right:14px;width:340px;background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--sh-xl);z-index:400;display:none;overflow:hidden;animation:fadeDown .2s ease}
.notif-head{padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.notif-head strong{font-family:var(--fd);font-weight:700;font-size:.85rem}
.notif-head button{background:none;border:none;cursor:pointer;color:var(--text-3);width:24px;height:24px;border-radius:4px;display:flex;align-items:center;justify-content:center}
.notif-head button:hover{background:var(--surface-2)}
.notif-item{padding:11px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background var(--tx)}
.notif-item:hover{background:var(--surface-2)}
.notif-item:last-child{border-bottom:none}
.notif-t{font-size:.8rem;font-weight:600}
.notif-m{font-size:.73rem;color:var(--text-2);margin-top:2px;line-height:1.4}
.notif-ts{font-size:.64rem;color:var(--text-3);margin-top:4px}

/* MAIN */
.main-content{grid-area:mc;padding:22px;overflow-y:auto;background:var(--bg);min-height:calc(100vh - var(--th))}
.page{display:none}
.page.active{display:block;animation:fadeUp .22s ease}

/* KPI CARDS */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:13px;margin-bottom:18px}
.kpi-card{background:var(--surface);border-radius:var(--r-lg);padding:18px;border:1px solid var(--border);box-shadow:var(--sh-xs);position:relative;overflow:hidden;transition:transform var(--tx-md),box-shadow var(--tx-md);cursor:default}
.kpi-card:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
.kpi-card::after{content:'';position:absolute;width:70px;height:70px;border-radius:50%;background:currentColor;opacity:.05;top:-30px;right:-30px}
.kpi-accent{position:absolute;top:0;left:0;right:0;height:3px;background:var(--blue);border-radius:3px 3px 0 0}
.kpi-card.gold .kpi-accent{background:var(--gold)} .kpi-card.gold{color:var(--gold-dk)}
.kpi-card.green .kpi-accent{background:var(--green)} .kpi-card.green{color:var(--green)}
.kpi-card.red .kpi-accent{background:var(--red)} .kpi-card.red{color:var(--red)}
.kpi-card.amber .kpi-accent{background:var(--amber)} .kpi-card.amber{color:var(--amber)}
.kpi-card.purple .kpi-accent{background:var(--purple)} .kpi-card.purple{color:var(--purple)}
.kpi-card.teal .kpi-accent{background:var(--teal)} .kpi-card.teal{color:var(--teal)}
.kpi-card.emerald .kpi-accent{background:var(--emerald)} .kpi-card.emerald{color:var(--emerald)}
.kpi-iw{width:36px;height:36px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;background:var(--blue-xl);color:var(--blue);margin-bottom:10px;position:relative;z-index:1}
.kpi-card.gold .kpi-iw{background:var(--gold-pale);color:var(--gold-dk)}
.kpi-card.green .kpi-iw{background:var(--green-lt);color:var(--green)}
.kpi-card.red .kpi-iw{background:var(--red-lt);color:var(--red)}
.kpi-card.amber .kpi-iw{background:var(--amber-lt);color:var(--amber)}
.kpi-card.purple .kpi-iw{background:var(--purple-lt);color:var(--purple)}
.kpi-card.teal .kpi-iw{background:var(--teal-lt);color:var(--teal)}
.kpi-card.emerald .kpi-iw{background:var(--emerald-lt);color:var(--emerald)}
.kpi-lbl{font-size:.67rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;position:relative;z-index:1}
.kpi-val{font-family:var(--fd);font-size:1.42rem;font-weight:800;color:var(--text);margin-top:3px;line-height:1;font-variant-numeric:tabular-nums;position:relative;z-index:1}
.kpi-sub{font-size:.69rem;color:var(--text-3);margin-top:4px;position:relative;z-index:1}

/* PANEL */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);margin-bottom:15px;box-shadow:var(--sh-xs);overflow:hidden}
.ph{padding:13px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px}
.pt{font-family:var(--fd);font-size:.85rem;font-weight:700;color:var(--text);display:flex;align-items:center;gap:7px}
.pt-ic{width:17px;height:17px;color:var(--blue);flex-shrink:0}
.pb{padding:17px 18px}

/* PAGE HD */
.page-hd{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:8px}
.page-hd h2{font-family:var(--fd);font-size:1.14rem;font-weight:800;color:var(--text);letter-spacing:-.4px}
.page-hd-sub{font-size:.77rem;color:var(--text-3);margin-top:3px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 15px;border-radius:var(--r-md);font-size:.8rem;font-weight:600;cursor:pointer;border:1.5px solid transparent;transition:all var(--tx);white-space:nowrap;font-family:var(--fb)}
.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-p{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn-p:hover{background:var(--blue-dk);box-shadow:0 2px 10px rgba(0,73,175,.3)}
.btn-y{background:var(--gold);color:var(--text);border-color:var(--gold);font-weight:700}
.btn-y:hover{background:var(--gold-dk);box-shadow:0 2px 10px rgba(250,175,52,.3)}
.btn-o{background:transparent;color:var(--blue);border-color:var(--blue)}
.btn-o:hover{background:var(--blue-xl)}
.btn-g{background:transparent;color:var(--text-2);border-color:var(--border)}
.btn-g:hover{background:var(--surface-2);border-color:var(--border-2)}
.btn-d{background:var(--red);color:#fff;border-color:var(--red)}
.btn-d:hover{background:#b91c1c}
.btn-ai{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;border:none;box-shadow:0 2px 10px rgba(99,102,241,.3)}
.btn-ai:hover{box-shadow:0 4px 18px rgba(99,102,241,.4)}
.btn-sm{padding:5px 11px;font-size:.75rem}
.btn-xs{padding:3px 8px;font-size:.7rem}
.btn-ic{width:15px;height:15px;flex-shrink:0}

/* FORMS */
.fg{display:grid;gap:13px}
.fg2{grid-template-columns:1fr 1fr}
.fg3{grid-template-columns:1fr 1fr 1fr}
.fg4{grid-template-columns:1fr 1fr 1fr 1fr}
.ff{display:flex;flex-direction:column}
.ff label{font-size:.68rem;font-weight:700;color:var(--text-2);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;display:flex;align-items:center;gap:4px}
.req{color:var(--red);font-size:.8rem}
.hint{font-size:.64rem;color:var(--text-3);text-transform:none;letter-spacing:0;font-weight:400}
.ff input,.ff select,.ff textarea{padding:9px 11px;border:1.5px solid var(--border);border-radius:var(--r-md);font-size:.86rem;color:var(--text);background:#fff;transition:border-color var(--tx),box-shadow var(--tx)}
.ff input:focus,.ff select:focus,.ff textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,73,175,.08)}
.ff input[readonly]{background:var(--surface-2);color:var(--text-3);cursor:not-allowed}
.ff-tip{font-size:.68rem;color:var(--text-3);margin-top:4px}
.form-actions{display:flex;gap:9px;justify-content:flex-end;padding-top:14px;border-top:1px solid var(--border);margin-top:14px}

/* TABLE */
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.tbl{width:100%;border-collapse:collapse;font-size:.79rem}
.tbl th{padding:9px 12px;text-align:left;font-size:.64rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border);background:var(--surface-2);white-space:nowrap}
.tbl td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:middle}
.tbl tbody tr{transition:background var(--tx)}
.tbl tbody tr:hover{background:var(--blue-2xl)}
.tbl tbody tr:last-child td{border-bottom:none}
.tbl tfoot td{padding:9px 12px;font-weight:700;border-top:2px solid var(--border);background:var(--surface-2)}

/* BADGES */
.bdg{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:var(--r-full);font-size:.64rem;font-weight:700;letter-spacing:.15px;text-transform:uppercase;white-space:nowrap}
.bdg-blue{background:var(--blue-xl);color:var(--blue)}
.bdg-green{background:var(--green-lt);color:var(--green)}
.bdg-red{background:var(--red-lt);color:var(--red)}
.bdg-amber{background:var(--amber-lt);color:var(--amber)}
.bdg-teal{background:var(--teal-lt);color:var(--teal)}
.bdg-purple{background:var(--purple-lt);color:var(--purple)}
.bdg-gold{background:var(--gold-pale);color:var(--gold-dk)}
.bdg-gray{background:var(--surface-2);color:var(--text-2)}
.bdg-emerald{background:var(--emerald-lt);color:var(--emerald)}

/* ALERTS */
.alert{display:flex;gap:9px;padding:11px 14px;border-radius:var(--r-md);font-size:.8rem;margin-bottom:11px;align-items:flex-start;line-height:1.5}
.alrt-ic{width:16px;height:16px;flex-shrink:0;margin-top:1px}
.alert-info{background:var(--teal-lt);color:var(--teal)}
.alert-warn{background:var(--amber-lt);color:var(--amber)}
.alert-ok{background:var(--green-lt);color:var(--green)}
.alert-err{background:var(--red-lt);color:var(--red)}
.alert-blue{background:var(--blue-xl);color:var(--blue)}

/* LOADING */
.lw{display:flex;align-items:center;justify-content:center;padding:48px;flex-direction:column;gap:12px}
.spin{width:28px;height:28px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:spin .7s linear infinite}
.lw-t{font-size:.78rem;color:var(--text-3);font-weight:500}

/* CHECKLIST */
.chk-wrap{display:flex;flex-direction:column;gap:8px}
.chk-item{display:flex;align-items:flex-start;gap:11px;padding:12px 14px;background:var(--surface-2);border-radius:var(--r-md);border:1.5px solid var(--border);cursor:pointer;transition:all var(--tx);user-select:none}
.chk-item:hover{border-color:var(--blue-lt);background:var(--blue-2xl)}
.chk-item.done{background:var(--green-lt);border-color:rgba(22,163,74,.3)}
.chk-item.done .chk-lbl{text-decoration:line-through;color:var(--text-3)}
.chk-box{width:20px;height:20px;border:2px solid var(--border-2);border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all var(--tx);background:#fff;margin-top:1px}
.chk-item.done .chk-box{background:var(--green);border-color:var(--green)}
.chk-body{flex:1;min-width:0}
.chk-lbl{font-size:.82rem;font-weight:600;color:var(--text);line-height:1.3}
.chk-desc{font-size:.72rem;color:var(--text-3);margin-top:2px;line-height:1.4}
.chk-meta{display:flex;align-items:center;gap:6px;margin-top:5px;flex-wrap:wrap}
.chk-obs-row{margin-top:7px}
.chk-obs{width:100%;padding:7px 10px;border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:.78rem;background:#fff;transition:border-color var(--tx)}
.chk-obs:focus{outline:none;border-color:var(--blue)}
.chk-prog-wrap{margin-bottom:14px}
.chk-prog-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.chk-prog-lbl{font-size:.76rem;font-weight:600;color:var(--text-2)}
.chk-prog-num{font-family:var(--fd);font-size:.82rem;font-weight:700;color:var(--blue)}
.chk-bar{height:7px;background:var(--border);border-radius:var(--r-full);overflow:hidden}
.chk-bar-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--gold));border-radius:var(--r-full);transition:width .5s cubic-bezier(.4,0,.2,1)}
.chk-cat-label{font-size:.65rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;margin:12px 0 7px;padding-bottom:5px;border-bottom:1px solid var(--border)}
.chk-submit-area{margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}

/* DESEMPENHO */
.rk-card{display:flex;align-items:center;gap:13px;padding:13px 15px;background:var(--surface-2);border:1.5px solid var(--border);border-radius:var(--r-lg);margin-bottom:9px;transition:all var(--tx-md)}
.rk-card:hover{border-color:var(--blue-lt);transform:translateX(2px)}
.rk-pos{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:800;font-size:.85rem;flex-shrink:0;color:#fff}
.rk-av{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:800;font-size:.92rem;flex-shrink:0;color:#fff}
.rk-info{flex:1;min-width:0}
.rk-nm{font-weight:700;font-size:.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rk-esp{font-size:.7rem;color:var(--text-3)}
.rk-bar{height:6px;background:var(--border);border-radius:var(--r-full);overflow:hidden;margin-top:6px}
.rk-bar-fill{height:100%;border-radius:var(--r-full);transition:width .7s cubic-bezier(.4,0,.2,1)}
.rk-val{text-align:right;flex-shrink:0}
.rk-val strong{font-family:var(--fd);font-size:.95rem;display:block}
.rk-val span{font-size:.66rem;color:var(--text-3)}

/* AI quick buttons (usados nos painéis do dashboard) */
.ai-qbtn{background:rgba(255,255,255,.12);color:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.2);border-radius:var(--r-full);padding:4px 11px;font-size:.72rem;cursor:pointer;transition:all var(--tx)}
.ai-qbtn:hover{background:rgba(255,255,255,.22);color:#fff}

/* AGENDA */
.ag-wrap{overflow-x:auto}
.ag-slot{height:52px;position:relative;cursor:pointer;border-left:1px solid var(--border);transition:background var(--tx)}
.ag-slot:hover{background:rgba(0,73,175,.04)}
.ag-event{position:absolute;top:2px;left:2px;right:2px;bottom:2px;border-radius:6px;padding:4px 6px;font-size:.67rem;font-weight:600;color:#fff;cursor:pointer;z-index:2;overflow:hidden;line-height:1.3;box-shadow:var(--sh-xs)}
.ag-event.cancelado{opacity:.4;text-decoration:line-through}
.ag-event.faltou{opacity:.55;border:2px dashed rgba(255,255,255,.4)}
.ag-event.compareceu{box-shadow:0 0 0 2px var(--green)}
.ag-scroll{overflow-y:auto;max-height:500px}
.ag-time{height:52px;display:flex;align-items:center;justify-content:flex-end;padding-right:10px;font-size:.66rem;color:var(--text-3);font-weight:500}

/* POKA YOKE STEPS */
.pk-step{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:var(--r-md);background:var(--blue-2xl);border:1.5px solid var(--blue-xl);margin-bottom:10px}
.pk-num{width:26px;height:26px;border-radius:50%;background:var(--blue);color:#fff;font-family:var(--fd);font-size:.82rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pk-txt{font-size:.79rem;color:var(--blue);font-weight:600}
.pk-step.done .pk-num{background:var(--green)}
.pk-step.done .pk-txt{color:var(--green)}

/* COMP DROP */
.comp-drop{border:2px dashed var(--border-2);border-radius:var(--r-md);padding:20px;text-align:center;color:var(--text-3);font-size:.79rem;cursor:pointer;transition:all var(--tx)}
.comp-drop:hover,.comp-drop.drag-over{border-color:var(--blue);background:var(--blue-xl);color:var(--blue)}

/* MODAL */
.modal-ov{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);z-index:600;display:none;align-items:center;justify-content:center;padding:20px;animation:fadeIn .18s ease}
.modal{background:#fff;border-radius:var(--r-xl);width:100%;max-width:560px;max-height:90vh;display:flex;flex-direction:column;box-shadow:var(--sh-xl);animation:fadeUp .22s ease}
.modal-lg{max-width:760px}
.modal-sm{max-width:400px}
.modal-hd{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.modal-hd h3{font-family:var(--fd);font-size:.93rem;font-weight:700}
.modal-x{background:none;border:none;font-size:1.1rem;cursor:pointer;color:var(--text-3);padding:4px 7px;border-radius:5px;width:28px;height:28px;display:flex;align-items:center;justify-content:center}
.modal-x:hover{background:var(--surface-2)}
.modal-bd{padding:20px;overflow-y:auto;flex:1}
.modal-ft{padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:9px;justify-content:flex-end}

/* TOAST */
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--text);color:#fff;padding:11px 18px;border-radius:var(--r-lg);font-size:.8rem;font-weight:500;z-index:900;box-shadow:var(--sh-lg);display:none;animation:slideUp .2s ease;max-width:88vw;align-items:center;gap:8px}
.toast.ok{background:var(--green)}
.toast.err{background:var(--red)}
.toast.warn{background:var(--amber)}

/* CHARTS */
.bar-wrap{display:flex;align-items:flex-end;gap:4px;height:120px;padding:0 2px}
.bc{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0}
.bs{width:100%;display:flex;flex-direction:column-reverse;height:100px;gap:1px}
.bs-seg{border-radius:3px 3px 0 0;transition:height .6s cubic-bezier(.4,0,.2,1)}
.bc-lbl{font-size:.57rem;color:var(--text-3);font-weight:600}
.chart-leg{display:flex;gap:13px;justify-content:center;margin-top:10px;flex-wrap:wrap}
.leg-i{display:flex;align-items:center;gap:5px;font-size:.71rem;color:var(--text-2)}
.leg-d{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.prog-bar{height:6px;background:var(--surface-2);border-radius:var(--r-full);overflow:hidden}
.prog-fill{height:100%;border-radius:var(--r-full);transition:width .7s cubic-bezier(.4,0,.2,1)}
.donut-wrap{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.donut-leg{flex:1;min-width:110px}
.dl-item{display:flex;align-items:center;gap:6px;font-size:.72rem;margin-bottom:5px}
.dl-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* PROF GRID */
.prof-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.prof-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:15px;display:flex;align-items:center;gap:12px;transition:all var(--tx-md)}
.prof-card:hover{border-color:var(--blue-lt);box-shadow:var(--sh-md)}
.prof-av{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-size:1rem;font-weight:800;flex-shrink:0;color:#fff}
.prof-info{flex:1;min-width:0}
.prof-nm{font-weight:700;font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prof-em{font-size:.72rem;color:var(--text-3);margin-top:1px}

/* DIVIDER */
.sdiv{display:flex;align-items:center;gap:10px;margin:20px 0 14px;color:var(--text-3);font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px}
.sdiv::before,.sdiv::after{content:'';flex:1;height:1px;background:var(--border)}

/* SECTION HEADER */
.page-sections{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-bottom:14px}
@media(max-width:700px){.page-sections{grid-template-columns:1fr}}

/* SB OVERLAY */
.sb-ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:99}
.sb-ov.on{display:block}

/* RESPONSIVE */
@media(max-width:900px){
  :root{--sw:0px}
  .app-shell{grid-template-columns:1fr;grid-template-areas:"tb""mc"}
  .sidebar{position:fixed;left:0;top:0;bottom:0;width:260px;transform:translateX(-100%);z-index:300}
  .sidebar.open{transform:translateX(0)}
  .sb-toggle{display:flex}
  .main-content{padding:14px}
  .fg3,.fg4{grid-template-columns:1fr 1fr}
  .kpi-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:540px){
  .fg2,.fg3,.fg4{grid-template-columns:1fr}
  .kpi-grid{grid-template-columns:1fr 1fr}
  .modal{max-height:96vh}
}

/* ANIMATIONS */
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeDown{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideUp{from{opacity:0;transform:translateX(-50%) translateY(8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
@keyframes aiDot{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
</style>
</head>
