function carregarLog(){
  const w=el('audit-cont');if(!w)return;
  w.innerHTML='<div class="lw"><div class="spin"></div></div>';
  google.script.run.withSuccessHandler(rows=>{
    if(!rows||!rows.length){w.innerHTML='<div class="alert alert-info">Nenhum registro.</div>';return;}
    w.innerHTML=`<div class="panel"><div class="tw"><table class="tbl"><thead><tr><th>Timestamp</th><th>Usuário</th><th>Ação</th><th>Detalhes</th></tr></thead><tbody>${rows.slice(-100).reverse().map(r=>`<tr><td style="white-space:nowrap;font-size:.72rem">${r.timestamp?new Date(r.timestamp).toLocaleString('pt-BR'):'—'}</td><td>${san(r.usuario||'—')}</td><td><span class="bdg ${r.acao&&r.acao.includes('DELETE')?'bdg-red':r.acao&&r.acao.includes('LOGIN')?'bdg-green':'bdg-blue'}">${san(r.acao||'—')}</span></td><td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.75rem">${san(r.detalhes||'—')}</td></tr>`).join('')}</tbody></table></div></div>`;
  }).withFailureHandler(e=>{w.innerHTML=`<div class="alert alert-err">${e.message}</div>`;}).getLog(APP.user);
}

// ================================================================
//  NOTIFICAÇÕES
// ================================================================
function carregarNotifs(){
  google.script.run.withSuccessHandler(notifs=>{
    const n=notifs?notifs.length:0;
    const bdg=el('notif-count');bdg.style.display=n>0?'flex':'none';bdg.textContent=n>9?'9+':n;
    renderNotifs(notifs||[]);
  }).getNotificacoes(APP.user?APP.user.perfil:'');
}
function renderNotifs(notifs){
  const l=el('notif-lista');if(!l)return;
  if(!notifs.length){l.innerHTML='<div style="padding:18px;text-align:center;color:var(--text-3);font-size:.78rem">Tudo em dia!</div>';return;}
  l.innerHTML=notifs.map(n=>`<div class="notif-item" onclick="lerNotif('${n.id}',this)"><div class="notif-t">${san(n.titulo)}</div><div class="notif-m">${san(n.mensagem)}</div><div class="notif-ts">${san(n.lancado_por||'sistema')} · ${n.criado_em?new Date(n.criado_em).toLocaleString('pt-BR'):''}</div></div>`).join('');
}
function lerNotif(id,el2){if(el2)el2.style.opacity='.4';google.script.run.withSuccessHandler(()=>carregarNotifs()).marcarNotificacaoLida(id);}
function toggleNotifs(){const p=el('notif-panel');p.style.display=(p.style.display==='block')?'none':'block';}
document.addEventListener('click',e=>{const p=el('notif-panel'),b=el('notif-btn');if(p&&b&&!p.contains(e.target)&&!b.contains(e.target))p.style.display='none';});

